package builtin.lsp.Lsp


// ── Posição e range ────────────────────────────────────────────────────────

// Posição dentro de um documento de texto. Linha e coluna são 0-based,
// conforme exigido pelo protocolo LSP.
struct LspPosition {
    public let line: int
    public let character: int
}

// Intervalo dentro de um documento de texto.
struct LspRange {
    public let start: LspPosition
    public let end: LspPosition
}

// Localização em um arquivo: URI + range.
struct LspLocation {
    public let uri: string
    public let range: LspRange
}

enum LspDocumentHighlightKind {
    Text
    Read
    Write
}

struct LspDocumentHighlight {
    public let range: LspRange
    public let kind: LspDocumentHighlightKind
}

// ── Diagnósticos ───────────────────────────────────────────────────────────

enum LspSeverity {
    Error        // 1
    Warning      // 2
    Information  // 3
    Hint         // 4
}

struct LspDiagnostic {
    public let range: LspRange
    public let severity: LspSeverity
    public let code: string
    public let source: string
    public let message: string
}

// ── Edição de texto ────────────────────────────────────────────────────────

// Substituição de um range no documento por `newText`.
// Inserção pura: start == end com newText != "".
// Deleção pura:  start != end com newText == "".
struct LspTextEdit {
    public let range: LspRange
    public let newText: string
}

// Conjunto de edições a aplicar em um documento específico.
struct LspDocumentChange {
    public let uri: string
    public let edits: LspTextEdit[]
}

// Code action retornada para textDocument/codeAction.
// Cada action carrega um conjunto de edições por documento.
struct LspCodeAction {
    public let title: string
    public let kind: string
    public let documentChanges: LspDocumentChange[]
}

// ── Completions e snippets ────────────────────────────────────────────────

enum LspCompletionKind {
    Text
    Method
    Function
    Variable
    Class
    Interface
    Keyword
    Snippet
    Type
}

enum LspInsertTextFormat {
    PlainText
    Snippet
}

enum LspSemanticTokenKind {
    Namespace
    Type
    Class
    Struct
    Enum
    Interface
    Function
    Method
    Property
    Field
    Variable
    Parameter
    Keyword
    Decorator
}

enum LspSemanticAccess {
    Public
    Internal
    Protected
    Private
}

struct LspCompletionItem {
    public let label: string
    public let kind: LspCompletionKind
    public let detail: string
    public let documentation: string
    public let insertText: string
    public let insertTextFormat: LspInsertTextFormat
    // Edições adicionais aplicadas junto com a inserção do item.
    // Usado para auto-import: insere a linha `import Pkg` ao aceitar um símbolo.
    public let additionalTextEdits: LspTextEdit[]
    // Substituição primária com range explícito.
    // Quando presente, o editor usa este textEdit em vez de insertText para garantir que o
    // prefixo já digitado (ex: `Aggitech.`) seja substituído pelo nome completo do pacote,
    // evitando a duplicação de componentes na linha de import.
    public let textEdit: LspTextEdit?
}

struct LspSemanticToken {
    public let range: LspRange
    public let kind: LspSemanticTokenKind
    public let access: LspSemanticAccess
}

// ── Code Lens ──────────────────────────────────────────────────────────────

// Comando que a IDE executa quando o code lens é clicado.
struct LspCommand {
    public let title: string
    public let command: string
    public let argumentJson: string
}

// Anotação de código exibida acima de uma linha pelo editor.
struct LspCodeLens {
    public let range: LspRange
    public let command: LspCommand
}

// ── Mensagem JSON-RPC ──────────────────────────────────────────────────────

enum LspMessageKind {
    Request
    Notification
    Response
}

// Mensagem recebida da IDE. O campo `paramsJson` contém o payload bruto em JSON.
struct LspMessage {
    public let kind: LspMessageKind
    public let id: int
    public let method: string
    public let paramsJson: string
}

// Erros de transporte do protocolo LSP.
enum LspError {
    IoError
    ParseError
    Shutdown
}

// ── I/O do protocolo (nativos) ─────────────────────────────────────────────

// Lê a próxima mensagem JSON-RPC do stdin.
// Bloqueia até receber uma mensagem completa (Content-Length + body).
@native("snovalang_lsp_read_message")
func readMessage(): Result<LspMessage, LspError>

// Envia uma resposta de sucesso para a mensagem com o `id` dado.
// `resultJson` é o payload JSON serializado.
@native("snovalang_lsp_send_response")
func sendResponse(id: int, resultJson: string): unit

// Envia uma resposta de erro para a mensagem com o `id` dado.
@native("snovalang_lsp_send_error")
func sendError(id: int, code: int, message: string): unit

// Envia uma notificação para a IDE (não exige resposta).
@native("snovalang_lsp_send_notification")
func sendNotification(method: string, paramsJson: string): unit

// Publica uma lista de diagnósticos para o `uri` indicado.
// Chamar com lista vazia limpa os diagnósticos do arquivo.
@native("snovalang_lsp_publish_diagnostics")
func publishDiagnostics(uri: string, diagnostics: LspDiagnostic[]): unit

// ── Resolução de arquivos ──────────────────────────────────────────────────

// Retorna o diretório raiz de fontes para o arquivo indicado pelo `uri`.
// Sobe nos ancestrais até encontrar `snova.toml` / `builtin.toml.Toml`.
@native("snovalang_lsp_source_root")
func sourceRoot(fileUri: string): string

// Varre o `sourceRoot` em busca do arquivo cujo `package` corresponde a
// `packageName`. Retorna o URI do arquivo encontrado, ou string vazia.
@native("snovalang_lsp_find_package_file")
func findPackageFile(sourceRoot: string, packageName: string): string

// Lista os pacotes `.snova` / `.sno` declarados sob `sourceRoot`.
// O host apenas varre arquivos; filtragem, ranking e montagem de completion
// pertencem ao compilador/LSP self-hosted.
@native("snovalang_lsp_package_names")
func packageNames(sourceRoot: string): string[]

// Lista símbolos importáveis declarados sob `sourceRoot` no formato
// `packageName.SymbolName`. O host não decide ranking nem visibilidade de
// linguagem; ele apenas extrai declarações de tipos de arquivos do projeto.
//
// Contrato de endereçamento: `SymbolName` DEVE ser o stem (nome do arquivo
// sem extensão) do arquivo que declara o símbolo, não o nome da classe/struct
// declarada dentro dele quando os dois divergem. `packageName.SymbolName` é
// exatamente a string que `import` deve usar para resolver esse arquivo
// (resolução estrita por arquivo — ver specs/20260704/strict-file-level-imports);
// qualquer implementação nativa deste `@native` deve preservar essa
// invariante para que as completions/quick-fixes de import gerados pelo LSP
// (compiler/src/lsp/semantic_completion_imports.snova,
// semantic_completion_autoimport.snova, code_actions.snova,
// semantic_completion_navigation.snova) produzam imports que de fato resolvem.
@native("snovalang_lsp_importable_symbols")
func importableSymbols(sourceRoot: string): string[]

// Retorna true quando `packageName` é um pacote nativo da stdlib Snovalang.
@native("snovalang_lsp_is_native_package")
func isNativePackage(packageName: string): bool

// ── Compilação ─────────────────────────────────────────────────────────────

// Compila `source` e retorna os diagnósticos encontrados.
// Não exige entrypoint — adequado para análise de arquivos abertos na IDE.
@native("snovalang_lsp_check_source")
func checkSource(source: string): LspDiagnostic[]

// ── Protocolo de completion (v2) ───────────────────────────────────────────

enum LspCompletionTriggerKind {
    Invoked                          // 1 — usuário pediu manualmente (Ctrl+Space)
    TriggerCharacter                 // 2 — disparado por caractere (e.g., ".", ":")
    TriggerForIncompleteCompletions  // 3 — refinar completions anteriores
}

struct LspCompletionContext {
    public let triggerKind: LspCompletionTriggerKind
    public let triggerCharacter: string
}

// ── Snapshot de documento (v2) ─────────────────────────────────────────────

// Snapshot imutável do estado de um documento num instante.
// Criado a cada mudança de versão; imutável após criação.
struct LspDocumentSnapshot {
    public let uri: string
    public let text: string
    public let version: int
    public let lines: string[]
    public let lineCount: int
}

// ── Resultados enriquecidos (v2) ───────────────────────────────────────────

struct LspDiagnosticResult {
    public let diagnostic: LspDiagnostic
    public let source: string
    public let fixes: LspCodeAction[]
}

struct LspCompletionCandidate {
    public let item: LspCompletionItem
    public let score: int
    public let depth: int
    public let deprecated: bool
}

// ── Contexto semântico do cursor (v2) ─────────────────────────────────────

enum LspCompletionContextKind {
    ImportDeclaration    // linha começa com "import " ou "using "
    MemberAccess         // prefixo termina com "."
    TypeAnnotation       // prefixo termina com ": "
    GenericArgument      // prefixo termina com "<"
    FunctionArgument     // dentro de parênteses de chamada
    TopLevel             // fora de qualquer tipo ou função
    InsideType           // dentro de struct/class/enum/interface
    InsideFunction       // dentro de método ou função
    General              // contexto desconhecido ou misto
}

struct LspCursorContext {
    public let snapshot: LspDocumentSnapshot
    public let position: LspPosition
    public let line: string
    public let prefix: string
    public let wordAtCursor: string
    public let triggerChar: string
    public let completionKind: LspCompletionContextKind
}
