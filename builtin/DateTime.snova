package builtin.datetime.DateTime


import builtin.metadata.Documented


// Errors arising from date/time parsing, construction, or zone resolution.
@Documented(
    description: "Errors arising from date/time parsing, construction, or time zone resolution.",
    example: "match DateTime.parseInstant(\"bad\") {\n    Err(DateTimeError.InvalidFormat(input)) -> print(input)\n    Ok(instant) -> print(instant.asString())\n}"
)
enum DateTimeError {
    InvalidFormat(input: string),
    OutOfRange(field: string, value: int),
    UnknownTimeZone(iana: string),
    InvalidPattern(pattern: string),
}

// ── Instant ────────────────────────────────────────────────────────────────

// A point in time represented as nanoseconds since the Unix epoch (UTC).
// All fields are immutable; arithmetic returns new values.
struct Instant {
    private let nanosEpoch: long

    @Documented(description: "Returns the number of nanoseconds since the Unix epoch (UTC).", example: "print(instant.nanos())", returnType: long)
    method nanos(): long {
        return nanosEpoch
    }

    @Documented(description: "Returns the number of milliseconds since the Unix epoch (UTC).", example: "print(instant.millis())", returnType: long)
    method millis(): long {
        return nanosEpoch / 1000000
    }

    @Documented(description: "Returns the number of seconds since the Unix epoch (UTC).", example: "print(instant.seconds())", returnType: long)
    method seconds(): long {
        return nanosEpoch / 1000000000
    }

    @Documented(description: "Returns a new Instant advanced by duration `d`.", example: "let later = instant.add(Duration.minutes(5))", args: "d: duration to add", returnType: Instant)
    method add(d: Duration): Instant {
        return Instant(nanosEpoch + d.toNanos())
    }

    @Documented(description: "Returns a new Instant moved back by duration `d`.", example: "let earlier = instant.sub(Duration.minutes(5))", args: "d: duration to subtract", returnType: Instant)
    method sub(d: Duration): Instant {
        return Instant(nanosEpoch - d.toNanos())
    }

    @Documented(description: "Returns the duration elapsed between `other` and this instant (this - other).", example: "let elapsed = instant.durationSince(start)", args: "other: earlier instant to compare against", returnType: Duration)
    method durationSince(other: Instant): Duration {
        return Duration(nanosEpoch - other.nanosEpoch)
    }

    @Documented(description: "Returns true when this instant occurs strictly before `other`.", example: "if instant.isBefore(deadline) { print(\"on time\") }", args: "other: instant to compare against", returnType: bool)
    method isBefore(other: Instant): bool {
        return nanosEpoch < other.nanosEpoch
    }

    @Documented(description: "Returns true when this instant occurs strictly after `other`.", example: "if instant.isAfter(deadline) { print(\"late\") }", args: "other: instant to compare against", returnType: bool)
    method isAfter(other: Instant): bool {
        return nanosEpoch > other.nanosEpoch
    }

    // Returns an ISO-8601 string with UTC suffix 'Z'.
    @Documented(description: "Returns an ISO-8601 string with UTC suffix 'Z'.", example: "print(instant.asString())", returnType: string)
    @native("snovalang_instant_as_string")
    method asString(): string

    @Documented(description: "Converts this instant to a LocalDateTime in the given time zone.", example: "let local = instant.toLocalDateTime(TimeZone.utc())", args: "tz: target time zone", returnType: LocalDateTime)
    @native("snovalang_instant_to_local_datetime")
    method toLocalDateTime(tz: TimeZone): LocalDateTime
}

// ── Duration ───────────────────────────────────────────────────────────────

// A signed span of time stored in nanoseconds. Negative durations are valid.
struct Duration {
    private let nanos: long

    @Documented(description: "Creates a Duration of `n` nanoseconds.", example: "let d = Duration.nanos(500)", args: "n: nanoseconds", returnType: Duration)
    static method nanos(n: long): Duration {
        return Duration(n)
    }

    @Documented(description: "Creates a Duration of `n` milliseconds.", example: "let d = Duration.millis(250)", args: "n: milliseconds", returnType: Duration)
    static method millis(n: long): Duration {
        return Duration(n * 1000000)
    }

    @Documented(description: "Creates a Duration of `n` seconds.", example: "let d = Duration.seconds(30)", args: "n: seconds", returnType: Duration)
    static method seconds(n: long): Duration {
        return Duration(n * 1000000000)
    }

    @Documented(description: "Creates a Duration of `n` minutes.", example: "let d = Duration.minutes(5)", args: "n: minutes", returnType: Duration)
    static method minutes(n: long): Duration {
        return Duration(n * 60000000000)
    }

    @Documented(description: "Creates a Duration of `n` hours.", example: "let d = Duration.hours(2)", args: "n: hours", returnType: Duration)
    static method hours(n: long): Duration {
        return Duration(n * 3600000000000)
    }

    @Documented(description: "Creates a Duration of `n` days.", example: "let d = Duration.days(1)", args: "n: days", returnType: Duration)
    static method days(n: long): Duration {
        return Duration(n * 86400000000000)
    }

    @Documented(description: "Returns the duration expressed in nanoseconds.", example: "print(d.toNanos())", returnType: long)
    method toNanos(): long {
        return nanos
    }

    @Documented(description: "Returns the duration expressed in milliseconds.", example: "print(d.toMillis())", returnType: long)
    method toMillis(): long {
        return nanos / 1000000
    }

    @Documented(description: "Returns the duration expressed in seconds.", example: "print(d.toSeconds())", returnType: long)
    method toSeconds(): long {
        return nanos / 1000000000
    }

    @Documented(description: "Returns the duration expressed in minutes.", example: "print(d.toMinutes())", returnType: long)
    method toMinutes(): long {
        return nanos / 60000000000
    }

    @Documented(description: "Returns the duration expressed in hours.", example: "print(d.toHours())", returnType: long)
    method toHours(): long {
        return nanos / 3600000000000
    }

    @Documented(description: "Returns the duration expressed in days.", example: "print(d.toDays())", returnType: long)
    method toDays(): long {
        return nanos / 86400000000000
    }

    @Documented(description: "Returns a new Duration that is the sum of this and `rhs`.", example: "let total = d1.add(d2)", args: "rhs: duration to add", returnType: Duration)
    method add(rhs: Duration): Duration {
        return Duration(nanos + rhs.nanos)
    }

    @Documented(description: "Returns a new Duration that is this minus `rhs`. May be negative.", example: "let diff = d1.sub(d2)", args: "rhs: duration to subtract", returnType: Duration)
    method sub(rhs: Duration): Duration {
        return Duration(nanos - rhs.nanos)
    }

    @Documented(description: "Returns a new Duration scaled by `factor`.", example: "let doubled = d.mul(2)", args: "factor: scalar multiplier", returnType: Duration)
    method mul(factor: long): Duration {
        return Duration(nanos * factor)
    }

    @Documented(description: "Returns true when the duration is negative.", example: "if d.isNegative() { print(\"in the past\") }", returnType: bool)
    method isNegative(): bool {
        return nanos < 0
    }

    @Documented(description: "Returns a new Duration with the absolute value of this duration.", example: "let positive = d.abs()", returnType: Duration)
    method abs(): Duration {
        if nanos < 0 {
            return Duration(-nanos)
        }
        return Duration(nanos)
    }

    // Returns a human-readable string such as "1h 30m 5s".
    @Documented(description: "Returns a human-readable string such as \"1h 30m 5s\".", example: "print(d.asString())", returnType: string)
    @native("snovalang_duration_as_string")
    method asString(): string
}

// ── LocalDate ──────────────────────────────────────────────────────────────

// A calendar date in the proleptic Gregorian calendar, without time or timezone.
struct LocalDate {
    let year: int
    let month: int
    let day: int

    // Returns Err when the date fields are out of range (e.g. Feb 29 on a non-leap year).
    @Documented(description: "Creates a LocalDate. Returns Err when the fields are out of range (e.g. Feb 29 on a non-leap year).", example: "let date = LocalDate.of(2026, 7, 11).unwrap()", args: "year: calendar year, month: 1-12, day: day of month", returnType: Result<LocalDate, DateTimeError>)
    @native("snovalang_local_date_of")
    static method of(year: int, month: int, day: int): Result<LocalDate, DateTimeError>

    @Documented(description: "Converts this date (at midnight) to an Instant in the given time zone.", example: "let instant = date.toInstant(TimeZone.utc())", args: "tz: target time zone", returnType: Instant)
    @native("snovalang_local_date_to_instant")
    method toInstant(tz: TimeZone): Instant

    @Documented(description: "Returns a new LocalDate advanced by the given number of days.", example: "let tomorrow = date.add(1)", args: "days: number of days to advance", returnType: LocalDate)
    @native("snovalang_local_date_add")
    method add(days: int): LocalDate

    @Documented(description: "Returns a new LocalDate moved back by the given number of days.", example: "let yesterday = date.sub(1)", args: "days: number of days to go back", returnType: LocalDate)
    @native("snovalang_local_date_sub")
    method sub(days: int): LocalDate

    // Returns the ISO day-of-week: 1 = Monday, 7 = Sunday.
    @Documented(description: "Returns the ISO day-of-week: 1 = Monday, 7 = Sunday.", example: "print(date.dayOfWeek())", returnType: int)
    @native("snovalang_local_date_day_of_week")
    method dayOfWeek(): int

    @Documented(description: "Returns true when this date's year is a leap year.", example: "if date.isLeapYear() { print(\"leap year\") }", returnType: bool)
    @native("snovalang_local_date_is_leap_year")
    method isLeapYear(): bool

    // Returns a YYYY-MM-DD formatted string.
    @Documented(description: "Returns a YYYY-MM-DD formatted string.", example: "print(date.asString())", returnType: string)
    @native("snovalang_local_date_as_string")
    method asString(): string
}

// ── LocalDateTime ─────────────────────────────────────────────────────────

// A date combined with a wall-clock time, without timezone information.
struct LocalDateTime {
    let date: LocalDate
    let hour: int
    let minute: int
    let second: int
    let nano: int

    @Documented(description: "Creates a LocalDateTime combining `date` with a wall-clock time.", example: "let dt = LocalDateTime.of(date, 14, 30, 0)", args: "date: calendar date, hour: 0-23, minute: 0-59, second: 0-59", returnType: LocalDateTime)
    static method of(date: LocalDate, hour: int, minute: int, second: int): LocalDateTime {
        return LocalDateTime(date, hour, minute, second, 0)
    }

    @Documented(description: "Converts this date-time to an Instant in the given time zone.", example: "let instant = dt.toInstant(TimeZone.utc())", args: "tz: target time zone", returnType: Instant)
    @native("snovalang_local_datetime_to_instant")
    method toInstant(tz: TimeZone): Instant

    @Documented(description: "Returns a new LocalDateTime advanced by duration `d`.", example: "let later = dt.add(Duration.hours(1))", args: "d: duration to add", returnType: LocalDateTime)
    @native("snovalang_local_datetime_add")
    method add(d: Duration): LocalDateTime

    // Returns a YYYY-MM-DDTHH:MM:SS formatted string.
    @Documented(description: "Returns a YYYY-MM-DDTHH:MM:SS formatted string.", example: "print(dt.asString())", returnType: string)
    @native("snovalang_local_datetime_as_string")
    method asString(): string
}

// ── TimeZone ───────────────────────────────────────────────────────────────

class TimeZone {
    private let iana: string

    @Documented(description: "Returns the UTC time zone.", example: "let tz = TimeZone.utc()", returnType: TimeZone)
    static method utc(): TimeZone {
        return TimeZone("UTC")
    }

    @Documented(description: "Returns the system's local time zone.", example: "let tz = TimeZone.local()", returnType: TimeZone)
    @native("snovalang_timezone_local")
    static method local(): TimeZone

    // Resolves an IANA timezone name such as "America/Sao_Paulo".
    // Returns Err(DateTimeError.UnknownTimeZone) when the name is not found.
    @Documented(description: "Resolves an IANA time zone name such as \"America/Sao_Paulo\". Returns Err(DateTimeError.UnknownTimeZone) when the name is not found.", example: "let tz = TimeZone.of(\"America/Sao_Paulo\").unwrap()", args: "iana: IANA time zone name", returnType: Result<TimeZone, DateTimeError>)
    @native("snovalang_timezone_of")
    static method of(iana: string): Result<TimeZone, DateTimeError>

    @Documented(description: "Returns the IANA name of this time zone.", example: "print(tz.name())", returnType: string)
    method name(): string {
        return iana
    }

    @Documented(description: "Returns the UTC offset for this time zone at the given instant.", example: "let offset = tz.offsetAt(DateTime.now())", args: "instant: point in time to resolve the offset at", returnType: Duration)
    @native("snovalang_timezone_offset_at")
    method offsetAt(instant: Instant): Duration
}

// ── DateTimeFormatter ─────────────────────────────────────────────────────

class DateTimeFormatter {
    private let pattern: string

    @Documented(description: "Returns a formatter that produces ISO-8601 strings.", example: "let fmt = DateTimeFormatter.iso8601()", returnType: DateTimeFormatter)
    static method iso8601(): DateTimeFormatter {
        return DateTimeFormatter("iso8601")
    }

    @Documented(description: "Creates a formatter from a custom pattern string. Returns Err when the pattern is invalid.", example: "let fmt = DateTimeFormatter.ofPattern(\"yyyy-MM-dd\").unwrap()", args: "pattern: format pattern string", returnType: Result<DateTimeFormatter, DateTimeError>)
    @native("snovalang_formatter_of_pattern")
    static method ofPattern(pattern: string): Result<DateTimeFormatter, DateTimeError>

    @Documented(description: "Formats an Instant using this formatter's pattern.", example: "print(fmt.format(DateTime.now()))", args: "instant: value to format", returnType: string)
    @native("snovalang_formatter_format_instant")
    method format(instant: Instant): string

    @Documented(description: "Formats a LocalDate using this formatter's pattern.", example: "print(fmt.formatDate(date))", args: "date: value to format", returnType: string)
    @native("snovalang_formatter_format_date")
    method formatDate(date: LocalDate): string

    @Documented(description: "Formats a LocalDateTime using this formatter's pattern.", example: "print(fmt.formatDateTime(dt))", args: "dt: value to format", returnType: string)
    @native("snovalang_formatter_format_datetime")
    method formatDateTime(dt: LocalDateTime): string

    @Documented(description: "Parses a string into an Instant using this formatter's pattern. Returns Err when the string doesn't match.", example: "let instant = fmt.parse(\"2026-07-11\").unwrap()", args: "value: string to parse", returnType: Result<Instant, DateTimeError>)
    @native("snovalang_formatter_parse")
    method parse(value: string): Result<Instant, DateTimeError>
}

// ── Top-level functions ────────────────────────────────────────────────────

// Returns the current UTC instant.
@Documented(description: "Returns the current UTC instant.", example: "let instant = DateTime.now()", returnType: Instant)
@native("snovalang_datetime_now")
public func now(): Instant

// Parses an ISO-8601 string into an Instant.
@Documented(description: "Parses an ISO-8601 string into an Instant.", example: "let instant = DateTime.parseInstant(\"2026-07-11T10:00:00Z\").unwrap()", args: "value: ISO-8601 string", returnType: Result<Instant, DateTimeError>)
@native("snovalang_datetime_parse_instant")
public func parseInstant(value: string): Result<Instant, DateTimeError>

// Parses an ISO date string (YYYY-MM-DD) into a LocalDate.
@Documented(description: "Parses an ISO date string (YYYY-MM-DD) into a LocalDate.", example: "let date = DateTime.parseDate(\"2026-07-11\").unwrap()", args: "value: ISO date string (YYYY-MM-DD)", returnType: Result<LocalDate, DateTimeError>)
@native("snovalang_datetime_parse_date")
public func parseDate(value: string): Result<LocalDate, DateTimeError>

// Parses an ISO datetime string (YYYY-MM-DDTHH:MM:SS) into a LocalDateTime.
@Documented(description: "Parses an ISO datetime string (YYYY-MM-DDTHH:MM:SS) into a LocalDateTime.", example: "let dt = DateTime.parseDateTime(\"2026-07-11T10:00:00\").unwrap()", args: "value: ISO datetime string (YYYY-MM-DDTHH:MM:SS)", returnType: Result<LocalDateTime, DateTimeError>)
@native("snovalang_datetime_parse_datetime")
public func parseDateTime(value: string): Result<LocalDateTime, DateTimeError>
