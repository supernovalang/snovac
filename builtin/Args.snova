package builtin.args.Args


// Error produced when an argument index is out of bounds.
enum ArgsError {
    OutOfBounds(index: int, count: int),
}

// Returns the number of command-line arguments passed to the process.
// The executable name (argv[0]) is excluded from the count.
@native("snovalang_args_count")
func count(): int

// Returns the argument at zero-based `index`, or None when out of range.
@native("snovalang_args_get")
func get(index: int): Option<string>

// Returns all arguments as an array, preserving order.
// Returns an empty array when no arguments were passed.
@native("snovalang_args_all")
func all(): Array<string>
