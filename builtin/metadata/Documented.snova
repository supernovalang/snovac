package builtin.metadata


// Placeholder marking a bare type reference passed as a decorator argument
// value — e.g. `returnType: LocalDate` or `returnType: List<T>` — rather
// than a runtime-constructible value. The Stage 0 extractor
// (`crates/snovalang/src/native/documented.rs`) captures the raw
// type-reference text following `returnType:`/`returnType=` (bracket-depth
// aware, so generics like `Result<LocalDate, DateTimeError>` are captured
// whole) instead of requiring a quoted string.
public struct Type {
    public let name: string
}

// Metadata decorator marking a declaration as documented.
//
// `@Documented(description: "...", example: "...", args: "...", returnType: SomeType)`
// attaches human-readable documentation to a class, struct, enum, method,
// function, or field. `description`, `example`, and `args` are named string
// arguments (`:` or `=`); `returnType` is a bare type reference (no quotes),
// e.g. `returnType: LocalDate` or `returnType: List<T>` — a `Type`, not a
// string. `args` and `returnType` are optional (empty when omitted) and
// hold, respectively, short prose describing parameters (e.g. "index:
// position to read from") and the declaration's return type — the same
// role `@param`/`@return` play in Kotlin's KDoc.
//
// This is a shape mirror only (same pattern as `builtin.types.Types` for
// `Option`/`Result`) — it carries no method bodies. Extraction is intrinsic
// to the Stage 0 compiler (`crates/snovalang/src/native/documented.rs`),
// which scans compiled sources for `@Documented(...)` blocks and associates
// each one with the declaration that immediately follows it; this struct
// exists so the language has a real, importable source of truth for the
// decorator's shape instead of it being pure LSP-hover convention.
//
// Unlike `Option`/`Result`, `Documented` is NOT auto-available — every file
// that uses `@Documented` must `import builtin.metadata.Documented`.
public struct Documented {
    public let description: string
    public let example: string
    public let args: string
    public let returnType: Type
}
