package builtin.runtimehost.RuntimeHost


// RuntimeHost — abstract runtime capabilities for domain libraries.
//
// This package defines the contracts that domain packages (http, sql, data, auth, …)
// implement against. It lives in the `core` stdlib slug.
//
// Lib makers (in their own `stdlib.snovalang.<slug>` registry repos — a remote
// repository name, not a language namespace) register extensions here so that
// the compiler, LSP and runtime discover decorators, validation rules and
// execution hooks without any hardcoded knowledge in the monorepo.
//
// Usage for a domain package author:
//
//   import builtin.runtimehost.RuntimeHost
//
//   func initRuntimeExtensions(): unit {
//       RuntimeExtensionRegistry.register(DecoratorExtension(
//           name: "GetRequest",
//           packageName: "builtin.http",
//           targetKinds: [ExtensionTargetKind.Function, ExtensionTargetKind.Method],
//           phase: ExtensionPhase.CompileTimeValidate,
//           validatorId: "http.endpoint.return_type",
//           runtimeHookId: "http.route.get",
//       ))
//       // ... more for PostRequest, HttpInterceptor, SqlQuery, etc.
//   }
//
// The runtime (Stage 0 + self-hosted) will call registered hooks at the
// appropriate phase. Default implementations for registry are in-memory maps
// in .snova; @native bridges cross to PAL when the concrete runtime needs
// to own sockets, threads, or OS resources.

// ──────────────────────────────────────────────────────────────────────────
// Platform capabilities (PAL-backed, provided by core)
// ──────────────────────────────────────────────────────────────────────────

interface ConsoleSink {
    // Write a line to stdout. Implementations must be non-blocking visible even
    // if the carrier thread is inside a long-running listener (see
    // httpserver-routing-and-console-visibility spec).
    method writeLine(text: string): Result<unit, string>

    method writeErrLine(text: string): Result<unit, string>
}

interface FileSystemOps {
    method readText(path: string): Result<string, string>
    method writeText(path: string, content: string): Result<unit, string>
    method exists(path: string): bool
    method createDirAll(path: string): Result<unit, string>
}

interface ProcessOps {
    method exec(command: string, args: Array<string>): Result<int, string>
    method spawn(command: string, args: Array<string>): Result<ProcessHandle, string>
}

@native struct ProcessHandle { public let id: int }

// ──────────────────────────────────────────────────────────────────────────
// Extension model — the primary way lib makers plug domain into the language
// ──────────────────────────────────────────────────────────────────────────

enum ExtensionTargetKind {
    Function
    Method
    Struct
    Class
    Field
    Package
    // Future: Interface, Trait, etc.
}

enum ExtensionPhase {
    // Validation at compile time (type rules, return types, decorator arg checks)
    CompileTimeValidate
    // Code generation / lowering hooks (e.g. SQL schema emission, route table)
    CompileTimeCodegen
    // Mount / initialization at program start (before main)
    RunTimeMount
    // Per-request or per-invocation (HTTP handler, SQL tx, etc.)
    RunTimeRequest
}

struct DecoratorExtension {
    public let name: string                 // e.g. "GetRequest"
    public let packageName: string          // e.g. "builtin.http"
    public let targetKinds: Array<ExtensionTargetKind>
    public let phase: ExtensionPhase
    // Identifier of the validator rule the package provides (resolved by name
    // inside the package or via another registered hook).
    public let validatorId: string
    // Identifier of the runtime hook the package will execute.
    public let runtimeHookId: string
    // Optional human description for LSP hover / docs.
    public let description: string
}

interface RuntimeExtensionRegistry {
    // Register a decorator extension. Idempotent per (packageName, name).
    method register(ext: DecoratorExtension): Result<unit, string>

    // Lookup by decorator name (last registration wins on conflict).
    method lookup(decoratorName: string): Option<DecoratorExtension>

    // All extensions contributed by one package.
    method extensionsForPackage(packageName: string): Array<DecoratorExtension>

    // All registered extensions (used by LSP / compiler for completion + facts).
    method all(): Array<DecoratorExtension>
}

// ──────────────────────────────────────────────────────────────────────────
// Request / invocation scope (unifies HTTP, gRPC, background jobs, …)
// ──────────────────────────────────────────────────────────────────────────

interface RequestScope {
    method console(): ConsoleSink
    method fileSystem(): FileSystemOps
    // Enter/exit for resource cleanup, context propagation, tracing.
    method enter(): unit
    method exit(): unit
    // Arbitrary attributes the concrete runtime can attach (trace id, user, …)
    method setAttribute(key: string, value: string): unit
    method getAttribute(key: string): Option<string>
}

interface RequestScopeFactory {
    // The current active scope for this thread / task, if any.
    method current(): Option<RequestScope>

    // Create a fresh scope (usually called by transport layer).
    method create(): RequestScope
}

// ──────────────────────────────────────────────────────────────────────────
// Runtime capability surface (what a concrete runtime must supply)
// ──────────────────────────────────────────────────────────────────────────

interface RuntimeHost {
    method console(): ConsoleSink
    method fileSystem(): FileSystemOps
    method process(): ProcessOps
    method extensionRegistry(): RuntimeExtensionRegistry
    method requestScopeFactory(): RequestScopeFactory
}

// Default host is provided by the Snovalang runtime implementation.
// Domain packages obtain it via:
//   let host: RuntimeHost = RuntimeHost.getDefault()
//   host.extensionRegistry().register(...)

@native("snovalang_runtime_host_default")
func getDefault(): RuntimeHost

// Convenience top-level registry (delegates to getDefault().extensionRegistry()).
let RuntimeExtensionRegistry: RuntimeExtensionRegistry = getDefault().extensionRegistry()

// Convenience scope factory.
let RequestScopeFactory: RequestScopeFactory = getDefault().requestScopeFactory()

// ──────────────────────────────────────────────────────────────────────────
// Notes for lib makers
// ──────────────────────────────────────────────────────────────────────────
//
// 1. Call your registration function early (top level or from a package init
//    that the runtime guarantees runs before user main).
//
// 2. For compile-time rules that used to be hardcoded (e.g. "GetRequest handler
//    must return HttpResponse"), register the extension with a validatorId.
//    The Stage 0 / compiler will consult RuntimeExtensionRegistry.lookup
//    and dispatch to package-provided validation when the id is known.
//
// 3. Runtime hooks (e.g. "http.route.get") are resolved at mount time by the
//    concrete runtime. The @native side of a domain package wires the actual
//    handler table into the HTTP listener etc.
//
// 4. Keep @native surface minimal. Most of the package (types, helpers,
//    fluent builders) should be pure .snova.
//
// 5. ConsoleSink must remain visible even when the main carrier thread blocks
//    inside HttpServer.listen — use the per-request scope or the global host
//    console that the runtime forwards to the real terminal fd.
