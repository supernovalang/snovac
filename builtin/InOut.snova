package builtin.inout.InOut


import builtin.strings.Strings


// Errors arising from I/O operations.
enum IoError {
    NotFound
    PermissionDenied
    BrokenPipe
    UnexpectedEof
    InvalidUtf8
    TimedOut
    Interrupted
    WouldBlock
    Other
}

// Errors arising from UTF-8 decoding.
enum Utf8Error {
    InvalidByte
    UnexpectedEnd
}

// An immutable slice of raw bytes with shared ownership (internally arc-backed).
// `slice` operations are zero-copy — they return a view over the original buffer.
struct Bytes {
    private let data: string
    private let start: int
    private let end: int

    // Creates a Bytes value over the UTF-8 encoding of `s`.
    static method fromString(s: string): Bytes {
        return Bytes(s, 0, Strings.byteLen(s))
    }

    // Returns an empty Bytes value.
    static method empty(): Bytes {
        return Bytes("", 0, 0)
    }

    // Returns the number of bytes in this slice.
    method len(): int {
        return end - start
    }

    method isEmpty(): bool {
        return end <= start
    }

    // Returns a sub-slice `[from, to)` without copying the underlying data.
    method slice(from: int, to: int): Bytes {
        return Bytes(data, start + from, start + to)
    }

    // Decodes the bytes as UTF-8 and returns the string.
    method asString(): Result<string, Utf8Error> {
        return data.substring(start, end)
    }

    method concat(other: Bytes): Bytes {
        return Bytes(data + other.data, 0, len() + other.len())
    }
}

// Contracts implemented by any type that produces bytes (files, sockets, pipes).
interface Reader {
    method read(count: int): Task<Result<Bytes, IoError>>
    method readExact(count: int): Task<Result<Bytes, IoError>>
    method readLine(): Task<Result<string, IoError>>
}

// Contracts implemented by any type that consumes bytes.
interface Writer {
    method write(buf: Bytes): Task<Result<int, IoError>>
    method writeAll(buf: Bytes): Task<Result<unit, IoError>>
    method writeString(s: string): Task<Result<unit, IoError>>
    method flush(): Task<Result<unit, IoError>>
}

// Implemented by resources that must be explicitly closed.
interface Closer {
    method close(): Result<unit, IoError>
}

// In-memory reader/writer pair — useful for testing and piping data between tasks.
// `pipe.writer()` and `pipe.reader()` communicate through a shared async buffer.
class Pipe {
    @native("snovalang_pipe_make")
    static method make(): Pipe

    @native("snovalang_pipe_reader")
    method reader(): PipeReader

    @native("snovalang_pipe_writer")
    method writer(): PipeWriter
}

class PipeReader {
    @native("snovalang_pipe_reader_read")
    method read(count: int): Task<Result<Bytes, IoError>>

    @native("snovalang_pipe_reader_close")
    method close(): Result<unit, IoError>
}

class PipeWriter {
    @native("snovalang_pipe_writer_write")
    method write(buf: Bytes): Task<Result<int, IoError>>

    @native("snovalang_pipe_writer_close")
    method close(): Result<unit, IoError>
}

// Copies all bytes from `src` to `dst` and returns the total byte count.
@native("snovalang_io_copy")
func copy(dst: PipeWriter, src: PipeReader): Task<Result<int, IoError>>

// Reads all remaining bytes from `src` into a single Bytes value.
@native("snovalang_io_read_all")
func readAll(src: PipeReader): Task<Result<Bytes, IoError>>
