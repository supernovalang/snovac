package builtin.json.Json


import builtin.collections.Collections


// Errors that can arise during serialization or deserialization.
enum JsonError {
    Parse(message: string, offset: int),
    TypeMismatch(expected: string, got: string, path: string),
    MissingField(field: string, path: string),
    UnknownField(field: string),
    NumberOverflow(value: string, target: string),
    Custom(message: string),
}

// ── Dynamic JSON tree ─────────────────────────────────────────────────────

// A dynamically-typed JSON value. Use this when the schema is unknown at
// compile time. For known schemas, prefer the @json decorator.
enum JsonValue {
    Null,
    Bool(value: bool),
    Number(value: decimal),
    Str(value: string),
    Array(items: Array<JsonValue>),
    Object(fields: Map<string, JsonValue>),
}

// Returns the child value associated with `key` in an Object, or None.
// Returns None without panicking when called on non-Object variants.
@native("snovalang_json_value_get")
func jsonGet(value: JsonValue, key: string): Option<JsonValue>

// Returns the item at `i` in an Array, or None.
// Returns None without panicking when called on non-Array variants.
@native("snovalang_json_value_index")
func jsonIndex(value: JsonValue, i: int): Option<JsonValue>

@native("snovalang_json_value_as_string")
func jsonAsString(value: JsonValue): Option<string>

@native("snovalang_json_value_as_number")
func jsonAsNumber(value: JsonValue): Option<decimal>

@native("snovalang_json_value_as_bool")
func jsonAsBool(value: JsonValue): Option<bool>

@native("snovalang_json_value_as_array")
func jsonAsArray(value: JsonValue): Option<Array<JsonValue>>

@native("snovalang_json_value_as_object")
func jsonAsObject(value: JsonValue): Option<Map<string, JsonValue>>

@native("snovalang_json_value_is_null")
func jsonIsNull(value: JsonValue): bool

// ── Decorators ────────────────────────────────────────────────────────────

// The @Json decorator marks a class or struct for automatic serialization.
// In Snovalang, decorators are regular structs used as metadata at compile time.
public struct Json {}

// The @JsonField decorator explicitly maps a property to a JSON key name.
// When `omitNull` is true, an Option field that is None will be omitted from the output JSON instead of writing `null`.
public struct JsonField {
    let name: string
    let omitNull: bool

    method new(name: string, omitNull: bool = false) {
        this.name = name
        this.omitNull = omitNull
    }
}

// ── Serializable / Deserializable contracts ───────────────────────────────

// Implemented by types decorated with @Json or with an explicit impl block.
// serialize() calls toJson() on the value and then stringifies the tree.
interface Serializable {
    method toJson(): Result<JsonValue, JsonError>
}

// Implemented by types decorated with @Json or with an explicit impl block.
// deserialize<T>() calls fromJson() with the parsed JsonValue tree.
interface Deserializable {
    static method fromJson(value: JsonValue): Result<Self, JsonError>
}

// ── Serialization ─────────────────────────────────────────────────────────

// Serializes `value` to a compact JSON string.
@native("snovalang_json_serialize")
func serialize<T: Serializable>(value: T): Result<string, JsonError>

// Serializes `value` to an indented JSON string. Default indent is 2 spaces.
@native("snovalang_json_serialize_pretty")
func serializePretty<T: Serializable>(value: T, indent: int = 2): Result<string, JsonError>

// Serializes `value` to a UTF-8 byte buffer.
@native("snovalang_json_serialize_bytes")
func serializeBytes<T: Serializable>(value: T): Result<Bytes, JsonError>

// ── Deserialization ────────────────────────────────────────────────────────

// Parses `json` and deserializes it into the type `T`.
@native("snovalang_json_deserialize")
func deserialize<T: Deserializable>(json: string): Result<T, JsonError>

@native("snovalang_json_deserialize_bytes")
func deserializeBytes<T: Deserializable>(json: Bytes): Result<T, JsonError>

// ── Dynamic parse / stringify ─────────────────────────────────────────────

// Parses a JSON string into a dynamic JsonValue tree.
// Returns Err(JsonError.Parse) for malformed input.
// Maximum nesting depth is 512 to prevent stack overflow.
@native("snovalang_json_parse")
func parse(json: string): Result<JsonValue, JsonError>

// Serializes a JsonValue tree to a compact JSON string.
@native("snovalang_json_stringify")
func stringify(value: JsonValue): Result<string, JsonError>

// Serializes a JsonValue tree to an indented JSON string.
@native("snovalang_json_stringify_pretty")
func stringifyPretty(value: JsonValue, indent: int = 2): Result<string, JsonError>
