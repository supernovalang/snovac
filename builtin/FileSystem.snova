package builtin.filesystem.FileSystem


import builtin.inout.InOut

import builtin.datetime.DateTime


// ── Path ───────────────────────────────────────────────────────────────────

// An immutable file-system path. All methods return new values without mutation.
struct Path {
    private let value: string

    static method of(value: string): Path {
        return Path(value)
    }

    // Returns the current working directory.
    @native("snovalang_path_current")
    static method current(): Path

    // Returns the user home directory, or None when it cannot be determined.
    @native("snovalang_path_home")
    static method home(): Option<Path>

    // Appends `component` to this path using the platform separator.
    @native("snovalang_path_join")
    method join(component: string): Path

    // Returns the parent directory, or None for the root path.
    @native("snovalang_path_parent")
    method parent(): Option<Path>

    // Returns the final path component (file or directory name).
    @native("snovalang_path_filename")
    method filename(): Option<string>

    // Returns the file extension without the leading dot.
    @native("snovalang_path_extension")
    method extension(): Option<string>

    // Returns the filename without its extension.
    @native("snovalang_path_stem")
    method stem(): Option<string>

    @native("snovalang_path_is_absolute")
    method isAbsolute(): bool

    @native("snovalang_path_is_relative")
    method isRelative(): bool

    method asString(): string {
        return value
    }

    // Resolves '..' and '.' components and returns a canonical path.
    @native("snovalang_path_normalize")
    method normalize(): Path
}

// ── File open modes ────────────────────────────────────────────────────────

enum OpenMode {
    Read,
    Write,
    Append,
    ReadWrite,
    CreateNew,
}

// ── SeekFrom ───────────────────────────────────────────────────────────────

enum SeekFrom {
    Start(offset: long),
    End(offset: long),
    Current(offset: long),
}

// ── File metadata ─────────────────────────────────────────────────────────

struct FileMetadata {
    let size: long
    let isFile: bool
    let isDir: bool
    let isSymlink: bool
    let created: Option<Instant>
    let modified: Instant
    let accessed: Option<Instant>
}

// ── File ───────────────────────────────────────────────────────────────────

// Async file handle. All I/O operations park the current task instead of
// blocking the carrier thread.
//
// Always close the file when done — either with close() or a defer:
//   let file = await File.open(path, OpenMode.Read)?
//   defer file.close()
class File {
    private let path: Path
    private let mode: OpenMode

    @native("snovalang_file_open")
    static method open(path: Path, mode: OpenMode): Task<Result<File, IoError>>

    @native("snovalang_file_read")
    method read(buf: &mut Bytes, count: int): Task<Result<int, IoError>>

    @native("snovalang_file_read_exact")
    method readExact(count: int): Task<Result<Bytes, IoError>>

    @native("snovalang_file_write")
    method write(buf: Bytes): Task<Result<int, IoError>>

    @native("snovalang_file_write_all")
    method writeAll(buf: Bytes): Task<Result<unit, IoError>>

    @native("snovalang_file_write_string")
    method writeString(s: string): Task<Result<unit, IoError>>

    @native("snovalang_file_flush")
    method flush(): Task<Result<unit, IoError>>

    @native("snovalang_file_seek")
    method seek(offset: long, from: SeekFrom): Task<Result<long, IoError>>

    @native("snovalang_file_tell")
    method tell(): Task<Result<long, IoError>>

    @native("snovalang_file_size")
    method size(): Task<Result<long, IoError>>

    @native("snovalang_file_close")
    method close(): Task<Result<unit, IoError>>

    method path(): Path {
        return path
    }

    method mode(): OpenMode {
        return mode
    }
}

// ── High-level operations ─────────────────────────────────────────────────

// Opens, reads, and closes the file at `path` in a single operation.
@errorVerify(
    condition: "fs.exists(path)",
    code: "SNOVA094",
    message: "file does not exist: ${path}",
    when: "path.isConst"
)
@native("snovalang_fs_read_text")
func readText(path: Path): Task<Result<string, IoError>>

// Writes `value` to `path`, creating or truncating the file.
@native("snovalang_fs_write_text")
func writeText(path: Path, value: string): Task<Result<unit, IoError>>

// Appends `value` to `path`, creating the file when it does not exist.
@native("snovalang_fs_append_text")
func appendText(path: Path, value: string): Task<Result<unit, IoError>>

@native("snovalang_fs_read_bytes")
func readBytes(path: Path): Task<Result<Bytes, IoError>>

@native("snovalang_fs_write_bytes")
func writeBytes(path: Path, data: Bytes): Task<Result<unit, IoError>>

@native("snovalang_fs_copy_file")
func copyFile(src: Path, dst: Path): Task<Result<unit, IoError>>

@native("snovalang_fs_move_file")
func moveFile(src: Path, dst: Path): Task<Result<unit, IoError>>

@native("snovalang_fs_delete_file")
func deleteFile(path: Path): Task<Result<unit, IoError>>

@native("snovalang_fs_exists")
func exists(path: Path): Task<Result<bool, IoError>>

@native("snovalang_fs_is_file")
func isFile(path: Path): Task<Result<bool, IoError>>

@native("snovalang_fs_is_dir")
func isDir(path: Path): Task<Result<bool, IoError>>

// ── Directory operations ──────────────────────────────────────────────────

@native("snovalang_fs_list_dir")
func listDir(path: Path): Task<Result<Array<Path>, IoError>>

@native("snovalang_fs_create_dir")
func createDir(path: Path): Task<Result<unit, IoError>>

// Creates all directories in the path, like `mkdir -p`.
@native("snovalang_fs_create_dirs")
func createDirs(path: Path): Task<Result<unit, IoError>>

// Removes the directory only when it is empty.
@native("snovalang_fs_delete_dir")
func deleteDir(path: Path): Task<Result<unit, IoError>>

// Recursively removes the directory and all its contents, like `rm -rf`.
@native("snovalang_fs_delete_dir_all")
func deleteDirAll(path: Path): Task<Result<unit, IoError>>

@native("snovalang_fs_metadata")
func metadata(path: Path): Task<Result<FileMetadata, IoError>>
