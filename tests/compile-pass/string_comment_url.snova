package tests.string_comment


import builtin.console.Console


// Verifies that `//` inside a string literal is NOT treated as a line comment.
// The URL must be preserved verbatim in the output.
func main(): int {
    let url = "https://example.com/api/v1"
    let note = "see http://docs.snovalang.io for details // not a comment"
    Console.printline("ok")
    return 0
}
